# Copy to .env and fill in. Never commit .env or the wallet keypair.

# Required
SOLANA_RPC_URL=https://your-rpc.example
BOT_WALLET_KEYPAIR_PATH=./wallet.json

# Optional
SOLANA_RPC_FALLBACK_URLS=
BOT_REGISTRY_FILE=./data/bots.json
BOT_PNL_LEDGER_FILE=./data/pnl-ledger.json
LOG_FILE=./data/logs/rebalancer.log
LOG_LEVEL=info
JUPITER_API_BASE_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=
# Control panel. Default bind is loopback only; if you set UI_HOST=0.0.0.0, also set UI_TOKEN
# (e.g. `openssl rand -hex 32`). When UI_TOKEN is set, the page and every /api request require it.
# UI_HOST=127.0.0.1
UI_PORT=8789
UI_TOKEN=

# Legacy CLI (npm run run / dry-run / rebalance-now) and scripts/ only.
# Meteora DLMM pool (lb pair) address, e.g. POOL_ADDRESS=<dlmm-pool-address>
POOL_ADDRESS=
# Maximum USD value the legacy CLI deploys (0 = no cap, deploy the whole wallet balance)
CLI_ALLOCATION_USDC=0
# Distribution strategy used by the legacy CLI: Spot, Curve or BidAsk
DEFAULT_STRATEGY=Spot

# Global trading defaults (legacy CLI only; control-panel bots use their own settings)
POLL_SECONDS=15
MAX_SLIPPAGE_BPS=100
SLIPPAGE_RETRIES_PER_TIER=3
OPEN_DEPLOYMENT_BUFFER_BPS=100
OPEN_RETRY_DEPLOYMENT_BUFFER_BPS=300
OPEN_FINAL_DEPLOYMENT_BUFFER_BPS=500
OPEN_BALANCE_TOLERANCE_BPS=25
