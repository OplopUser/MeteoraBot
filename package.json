{
  "name": "meteora-dlmm-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "run": "tsx src/index.ts run",
    "dry-run": "tsx src/index.ts dry-run",
    "rebalance-now": "tsx src/index.ts rebalance-now",
    "ui": "tsx src/controlPanel.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@meteora-ag/dlmm": "^1.3.0",
    "@solana/web3.js": "^1.98.0",
    "bn.js": "^5.2.1",
    "bs58": "^6.0.0",
    "dotenv": "^17.0.0",
    "pino": "^10.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
